DATABASE_URL="postgresql://fleetflow:fleetflow@localhost:5433/fleetflow"
# Docker Compose reads these three for the postgres container (see docker-compose.yml);
# keep them consistent with the credentials embedded in DATABASE_URL above.
POSTGRES_USER="fleetflow"
POSTGRES_PASSWORD="fleetflow"
POSTGRES_DB="fleetflow"
JWT_ACCESS_SECRET="change-me-access"
JWT_CUSTOMER_ACCESS_SECRET="change-me-customer-access"
CLOUDINARY_URL="cloudinary://placeholder-api-key:placeholder-api-secret@placeholder-cloud-name"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Pinned explicitly in the Stripe client constructor rather than left to the
# SDK's own bundled default, so an SDK upgrade can't silently change
# request/response shapes under us. Matches the version `stripe` (see
# package.json) resolves to today.
STRIPE_API_VERSION="2026-09-30.endive"
SEED_ADMIN_EMAIL="admin@fleetflow.local"
SEED_ADMIN_PASSWORD="change-me-now"
DEFAULT_CURRENCY="usd"
INVOICE_DUE_DAYS="14"
FRONTEND_ORIGIN="http://localhost:3001"
INVITE_TTL_HOURS="72"
# Leave empty to use the console email logger for local dev (no real emails sent).
RESEND_API_KEY=""
EMAIL_FROM="FleetFlow <no-reply@fleetflow.local>"
